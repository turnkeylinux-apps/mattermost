#!/bin/bash -e
# set Mattermost user, password and email; set user to admin

. /etc/default/inithooks

[ -e $INITHOOKS_CONF ] && . $INITHOOKS_CONF
printf '%s\n' "$APP_PASS" | \
    $INITHOOKS_PATH/bin/mattermost.py --pass-stdin \
        --email="$APP_EMAIL" --domain="$APP_DOMAIN"

# Nginx may have attempted its initial start before the firstboot TLS
# certificate existed. Restart it now that certificate generation and the
# application configuration are complete.
systemctl restart nginx.service
