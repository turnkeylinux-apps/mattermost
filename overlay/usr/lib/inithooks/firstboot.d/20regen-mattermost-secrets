#!/bin/bash -e
# regenerate mattermost secrets

. /etc/default/inithooks

gen-salt() {
    openssl rand -hex 16
}

MMCTL=/opt/mattermost/bin/mmctl
LOCAL_SOCKET=/var/tmp/mattermost_local.socket
SETTINGS="SqlSettings.AtRestEncryptKey FileSettings.PublicLinkSalt"

systemctl start mattermost.service
for _ in $(seq 1 60); do
    [ ! -S "$LOCAL_SOCKET" ] || break
    sleep 1
done
[ -S "$LOCAL_SOCKET" ]

for SETTING in $SETTINGS; do
    runuser -u mattermost -- "$MMCTL" --local config set \
        "$SETTING" "$(gen-salt)"
done

systemctl restart mattermost.service
