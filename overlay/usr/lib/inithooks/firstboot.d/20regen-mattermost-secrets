#!/bin/bash -e
# regenerate mattermost secrets

. /etc/default/inithooks

gen-salt() {
    openssl rand -hex 16
}

MMCTL=/opt/mattermost/bin/mmctl
SETTINGS="SqlSettings.AtRestEncryptKey FileSettings.PublicLinkSalt EmailSettings.InviteSalt EmailSettings.PasswordResetSalt"

for SETTING in $SETTINGS; do
    runuser -u mattermost -- "$MMCTL" --local config set \
        "$SETTING" "$(gen-salt)"
done

systemctl restart mattermost.service
